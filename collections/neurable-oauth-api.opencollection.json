{
  "opencollection": "1.0.0",
  "info": {
    "name": "neu-pipe-service O Auth API",
    "version": "0.0.24"
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Oauth Authorize",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth/authorize",
            "params": [
              {
                "name": "client_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "response_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge_method",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "audience",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "nonce",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Initiate the authorization code grant flow (PKCE required)."
        },
        {
          "info": {
            "name": "Post Oauth Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Exchange an authorization code for an access token."
        },
        {
          "info": {
            "name": "Get Well Known Jwks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/.well-known/jwks.json"
          },
          "docs": "Retieve public signing key for JWTs issued by this API."
        }
      ]
    }
  ],
  "bundled": true
}